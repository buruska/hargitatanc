generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum TicketMode {
  LINK
  VENUE
  FREE
  PASS
  CUSTOM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  summary     String
  coverImageUrl String?
  isFeatured  Boolean  @default(false)
  isBookable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunningPerformance {
  id            String   @id @default(cuid())
  title         String
  titleRo       String?
  titleEn       String?
  slug          String   @unique
  summary       String
  summaryRo     String?
  summaryEn     String?
  coverImageUrl String
  isGalleryOnly Boolean @default(false)
  galleryIsPublished Boolean @default(true)
  gallerySortOrder Int @default(0)
  events        RunningPerformanceEvent[]
  galleryImages RunningPerformanceGalleryImage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RunningPerformanceGalleryImage {
  id                   String             @id @default(cuid())
  runningPerformanceId String
  runningPerformance   RunningPerformance @relation(fields: [runningPerformanceId], references: [id], onDelete: Cascade)
  imageUrl             String
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now())

  @@index([runningPerformanceId])
}

model RunningPerformanceEvent {
  id                   String             @id @default(cuid())
  runningPerformanceId String
  runningPerformance   RunningPerformance @relation(fields: [runningPerformanceId], references: [id], onDelete: Cascade)
  startsAt             DateTime
  location             String
  ticketMode           TicketMode         @default(LINK)
  ticketUrl            String
  ticketText           String             @default("")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([runningPerformanceId])
  @@index([startsAt])
}

model NewsPost {
  id          String   @id @default(cuid())
  locale      String   @default("hu")
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id        String   @id @default(cuid())
  name      String
  role      String
  roleRo    String?
  roleEn    String?
  bio       String?
  bioRo     String?
  bioEn     String?
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id            String   @id @default("main")
  groupImageUrl String?
  introText     String?
  introTextRo   String?
  introTextEn   String?
  directorName  String?
  directorNameRo String?
  directorNameEn String?
  directorTitle String?
  directorBio   String?
  directorBioRo String?
  directorBioEn String?
  directorImageUrl String?
  facebookUrl   String   @default("https://www.facebook.com/hargitaegyuttes")
  instagramUrl  String   @default("https://www.instagram.com/hargitaneptancszinhaz")
  tiktokUrl     String   @default("#")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GalleryAlbum {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DefaultCoverImage {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
