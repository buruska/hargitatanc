# Másold ezt a fájlt .env.docker néven, majd cseréld le az értékeket.
# A DATABASE_URL értékét a compose.yaml rögzíti a tartós Docker volume-ra.

# Generálás PowerShellben:
# $bytes = New-Object byte[] 64
# [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
# [Convert]::ToBase64String($bytes)
AUTH_SECRET="CSERELD_LE_EGY_LEGALABB_64_KARAKTERES_VELETLEN_ERTEKRE"

# Csak az első `npm run db:seed` futtatás használja az admin létrehozásához.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CSERELD_LE_EGY_EROS_LEGALABB_12_KARAKTERES_JELSZORA"
